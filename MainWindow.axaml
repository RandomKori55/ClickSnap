<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ClickSnap.MainWindow"
        Title="ClickSnap"
        Width="520"
        Height="340"
        Icon="/Assets/app.ico">

    <StackPanel Margin="16" Spacing="10">
        <TextBlock Text="ClickSnap"
                   FontSize="22"
                   FontWeight="Bold" />

        <TextBlock Text="Folder for screenshots:" />

        <TextBlock x:Name="FolderPath"
                   Text="(not selected)"
                   TextWrapping="Wrap" />

        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Browse..."
                    Click="BrowseFolder_Click" />

            <Button x:Name="ToggleButton"
                    Content="Start"
                    Click="ToggleButton_Click" />

            <Button Content="Donate"
                    Click="Donate_Click" />
        </StackPanel>

        <TextBlock x:Name="InfoText"
                   Text="Screenshots taken: 0" />

        <TextBlock x:Name="StatusText"
                   Text="Ready"
                   Foreground="Gray"
                   TextWrapping="Wrap" />
    </StackPanel>

</Window>